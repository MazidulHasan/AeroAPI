{
  "info": {
    "_postman_id": "a577db17-41e8-4a85-8f23-a0a190a1b32b",
    "name": "CheckOut",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "55210884",
    "_collection_link": "https://go.postman.co/collection/55210884-a577db17-41e8-4a85-8f23-a0a190a1b32b?source=collection_link"
  },
  "item": [
    {
      "name": "1. Clear Pre-existing Cart",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/cart",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "cart"
          ]
        }
      },
      "response": []
    },
    {
      "name": "3. Checkout order",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Calculates correct total amount\", function () {",
              "    var jsonData = pm.response.json();",
              "    // 149.99 * 2 = 299.98",
              "    pm.expect(jsonData.amount).to.eql(299.98);",
              "});",
              "",
              "pm.test(\"Generates order ID and sets confirmed status\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('orderId');",
              "    pm.expect(jsonData.status).to.eql('confirmed');",
              "",
              "    // Save order ID for later verification",
              "    pm.environment.set(\"latestOrderId\", jsonData.orderId);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/checkout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "checkout"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2. Add Extracted Product to Cart",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Cart contains the newly added item\", function () {",
              "    var jsonData = pm.response.json();",
              "    const item = jsonData.cart.items.find(i => i.productId === pm.environment.get(\"customProductId\"));",
              "    pm.expect(item).to.exist;",
              "    pm.expect(item.quantity).to.eql(2);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": \"{{customProductId}}\",\n  \"quantity\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/cart",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "cart"
          ]
        }
      },
      "response": []
    },
    {
      "name": "4. Verify Order Appears In History",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Order ID exists in history array\", function () {",
              "    var jsonData = pm.response.json();",
              "    const targetOrder = pm.environment.get(\"latestOrderId\");",
              "    const found = jsonData.some(order => order.id === targetOrder);",
              "    pm.expect(found).to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders"
          ]
        }
      },
      "response": []
    }
  ]
}